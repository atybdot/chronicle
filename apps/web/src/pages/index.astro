---
import IndexLayout from "../layouts/index-layout.astro";
import CopyBtn from "@react/copy-btn";
import TerminalWindow from "@/components/terminal-window.astro";
import Features from "@/components/features.astro";
import { Code } from "astro:components";
import Usage from "@/components/usage.astro";
import Command from "@/components/command.astro";
const bunUnix = "curl -fsSL https://bun.sh/install | bash";
const bunWindows = 'powershell -c "irm bun.sh/install.ps1 | iex"';
const installChronicle = "bun add -g @atybdot/chronicle";
---

<IndexLayout>
  <main
    class="max-w-3xl mx-auto px-6 py-12 pt-24 space-y-10"
    transition:name="page-content"
  >
    <section class="space-y-10">
      <div class="space-y-6">
        <h1 class="text-4xl font-semibold">Chronicle.</h1>
        <h2 class="text-zinc-500 text-sm sm:text-base sm:leading-relaxed -mt-4">
          transform uncommitted changes into atomic, well-organized commits with
          realistic timestamps using AI.
        </h2>
        <div class="space-y-3">
          <p class="text-sm text-zinc-500">
            Install Bun, then open a new terminal.
          </p>
          <div class="install-cmd overflow-hidden rounded-lg">
            <div class="flex justify-between items-center px-4 py-2 bg-zinc-800">
              <span class="text-sm text-zinc-500">macOS / Linux</span>
              <CopyBtn client:load transition:persist="copy-bun-unix" text={bunUnix} />
            </div>
            <Code
              code={bunUnix}
              class="px-4 py-3 **:bg-transparent! bg-zinc-900! text-sm"
              theme={"ayu-mirage"}
              lang="bash"
            />
          </div>
          <div class="install-cmd overflow-hidden rounded-lg">
            <div class="flex justify-between items-center px-4 py-2 bg-zinc-800">
              <span class="text-sm text-zinc-500">Windows (PowerShell)</span>
              <CopyBtn client:load transition:persist="copy-bun-windows" text={bunWindows} />
            </div>
            <Code
              code={bunWindows}
              class="px-4 py-3 **:bg-transparent! bg-zinc-900! text-sm"
              theme={"ayu-mirage"}
              lang="powershell"
            />
          </div>
          <div class="install-cmd overflow-hidden rounded-lg">
            <div class="flex justify-between items-center px-4 py-2 bg-zinc-800">
              <span class="text-sm text-zinc-500">Then install Chronicle</span>
              <CopyBtn client:load transition:persist="copy-chronicle" text={installChronicle} />
            </div>
            <Code
              code={installChronicle}
              class="px-4 py-3 **:bg-transparent! bg-zinc-900! text-sm"
              theme={"ayu-mirage"}
              lang="bash"
            />
          </div>
        </div>
        <TerminalWindow />
      </div>
    </section>

    <Features />
    <Usage />
    <Command />
  </main>
</IndexLayout>

<style>
  .install-cmd :global(pre),
  .install-cmd :global(code) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
