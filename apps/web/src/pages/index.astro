---
import IndexLayout from "../layouts/index-layout.astro";
import CopyBtn from "@react/copy-btn";
import TerminalWindow from "@/components/terminal-window.astro";
import Features from "@/components/features.astro";
import { Code } from "astro:components";
import Usage from "@/components/usage.astro";
import Command from "@/components/command.astro";
const installCode = `curl -fsSL https://bun.sh/install | bash
# Windows (PowerShell)
powershell -c "irm bun.sh/install.ps1 | iex"
bun add -g @atybdot/chronicle`;
---

<IndexLayout>
  <main
    class="max-w-3xl mx-auto px-6 py-12 pt-24 space-y-10"
    transition:name="page-content"
  >
    <section class="space-y-10">
      <div class="space-y-6">
        <h1 class="text-4xl font-semibold">Chronicle.</h1>
        <h2 class="text-zinc-500 text-sm sm:text-base sm:leading-relaxed -mt-4">
          transform uncommitted changes into atomic, well-organized commits with
          realistic timestamps using AI.
        </h2>
        <div class="install-code relative overflow-hidden rounded-lg">
          <Code
            code={installCode}
            class="flex-1 py-3 pl-4 pr-10 **:bg-transparent! bg-zinc-900! text-sm"
            theme={"ayu-mirage"}
            lang="bash"
          />

          <CopyBtn
            client:load
            transition:persist
            className=" absolute z-10! right-3 top-3"
            text={installCode}
          />
        </div>
        <TerminalWindow />
      </div>
    </section>

    <Features />
    <Usage />
    <Command />
  </main>
</IndexLayout>

<style>
  .install-code :global(pre),
  .install-code :global(code) {
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
</style>
